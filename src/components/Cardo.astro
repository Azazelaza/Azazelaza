      bottom: 0;
    }
  } */
  .dividendo {
    opacity: 0;
    transition: 0.5s all;
    text-align: start;
    ul {
      padding: 0 20px;
    }
    h2 {
      text-align: center;
      margin: 1rem;
    }
    a:hover {
      color: #c3ade5;
    }
    a {
      color: white;
      font-size: 20px;
      text-decoration: none;
    }
  }
  .link-card {
    width: 48%;
    list-style: none;
    display: flex;
    background-color: #23262d;
    text-align: center;
    border-radius: 8px;
    background-position: 100%;
    height: 190px;
    transition:
      height 0.5s ease-in-out,
      width 0.5s ease-in-out 0.5s,
      top 0.5s ease-in-out 1s,
      background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    position: absolute;
    &.one {
      top: 0;
    }
    &.two {
      top: 0;
      right: 0;
    }
    &.three {
      top: 220px;
      bottom: 0px;
    }
    &.fourth {
      top: 220px;
      right: 0;
      bottom: 0;
    }

    &.active {
      transition:
        top 0.5s ease-in-out,
        width 0.5s ease-in-out 0.5s,
        height 0.5s ease-in-out 1s,
        background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      background-image: none !important;
      bottom: 0;
      &.one,
      &.two,
      &.three,
      &.fourth {
        width: 100%;
        height: 930px;
        top: -222px;
      }
      .body {
        .dividendo {
          opacity: 1;
          transition: 1s all 1.3s;
        }
      }
    }
  }
  .link-card > .body {
    width: 100%;
    text-decoration: none;
    line-height: 1.4;
    padding: calc(1.5rem - 1px);
    border-radius: 8px;
    color: white;
    background-color: #23262d;
    opacity: 0.8;
    cursor: pointer;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  p {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
  .link-card:is(:hover, :focus-within) {
    background-position: 0;
    background-image: var(--accent-gradient);
  }
  .link-card:is(:hover, :focus-within) h2 {
    color: rgb(var(--accent-light));
  }
</style>
