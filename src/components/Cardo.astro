<script>
  import { isOpen } from "../store/store.js";
  document.querySelectorAll(".link-card").forEach((b) => {
    b.addEventListener("click", () => {
      isOpen.set(!isOpen.value);
      document.querySelector(".link-card-grid")?.classList.add("anyOpen");
      if (b.classList.contains("active")) {
        document.querySelector(".link-card-grid")?.classList.remove("anyOpen");
        document
          .querySelector(".b-z-b." + b.classList[1])
          ?.classList.remove("active");
        return b.classList.remove("active");
      }
      document
        .querySelector(".b-z-b." + b.classList[1])
        ?.classList.add("active");
      b.classList.add("active");
    });
  });
</script>
<style>
  /* TODO: Concepto de cards con slide */
