---
import Layout from "../layouts/Layout.astro";
import Cardo from "../components/Cardo.astro";
---

<Layout title="Welcome to Astro.">
  <main>
    <img src="/img/yo.png" width="200" class="center" alt="my_face" />
    <small class="center presentation"
      >Kravitz Tlaloc Azazel Araiza Aviles</small
    >
    <h1>Programador web <br /><span class="text-gradient">Full Stack</span></h1>
    <p class="instructions center">
      Tengo <b>7 años de experiencia</b> en el campo laboral.
      <br />
      Me encanta aprender programación y mi mayor prioridad es el equilibrio entre
      la calidad de código y producto
    </p>
    <ul role="list" class:list={["link-card-grid"]}>
      <Cardo
        href="https://docs.astro.build/"
        title="Sobre Mi"
        class="one"
        body="Conoce un poco sobre mi y como me aventure dentro del mundo de la programacion."
      />
      <Cardo
        href="https://astro.build/integrations/"
        title="Servicios"
        class="two"
        body="Visualiza los servicios que ofrezco dentro de mis capacidades y alineaciones."
      />
      <Cardo
        href="https://astro.build/themes/"
        title="Portafolio"
        class="three"
        body="Revisa todos mis clientes y que tal he trabajado en sus paginas webs y proyectos."
      />
      <Cardo
        href="https://astro.build/chat/"
        title="Contacto"
        class="fourth"
        body="Contactame veamos que tipo de desarrollo se adapta a tus necesidades o para ofertas de trabajo"
      />
    </ul>
  </main>
</Layout>

<style>
  .presentation {
    font-size: 40px;
    font-weight: 700;
  }
  .center {
    text-align: center;
    display: block;
    margin: auto;
  }
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  .instructions {
    margin-bottom: 2rem;
    background: linear-gradient(
      rgba(var(--accent-dark), 66%),
      rgba(var(--accent-dark), 33%)
    );
    padding: 0 1.5rem;
    border-radius: 8px;
    height: 190px;
    align-items: center;
    align-content: center;
  }
  .link-card-grid {
    padding: 0;
    gap: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: stretch;
    position: relative;
    height: 410px;

    &.anyOpen {
      li:not(.active) {
        &.one,
        &.two {
          top: 730px;
        }
        &.three,
        &.fourth {
          top: 950px;
        }
      }
    }
  }
</style>
